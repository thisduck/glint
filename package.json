{
  "name": "glint",
  "version": "0.1.4",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "build": "node scripts/build-window-bounds.cjs && tailwindcss -i src/style.css -o dist/ui.css --minify && esbuild src/ui.tsx --bundle --outfile=dist/ui.js --define:process.env.NODE_ENV='\"production\"'",
    "start": "npm run build && node scripts/start.cjs",
    "test": "node --test tests/*.test.cjs",
    "package:mac": "pnpm build && node scripts/package-mac.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "lucide-react": "0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "esbuild": "0.27.7",
    "tailwindcss": "3.4.19"
  },
  "productName": "glint"
}
