{
  "name": "cinderella",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "build": "tailwindcss -i src/style.css -o dist/ui.css --minify && esbuild src/ui.tsx --bundle --outfile=dist/ui.js --define:process.env.NODE_ENV='\"production\"'",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "esbuild": "0.27.7",
    "tailwindcss": "3.4.19"
  }
}
